pipeline {
  agent any
  stages {
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }

    // EJERCICIO 3: Construir imagen CI con make
    stage('CI - Build tools image') {
      steps {
        script {
          echo 'Construyendo la imagen Docker de herramientas CI...'
          docker.build("python-ci-tools:${env.BUILD_NUMBER}", "-f devops/ci.Dockerfile .")
        }
      }
    }

    // EJERCICIO 3: Separar stage Lint
    stage('CI - Lint') {
      steps {
        script {
          docker.image("python-ci-tools:${env.BUILD_NUMBER}").inside {
            echo 'Instalando dependencias de Lint...'
            sh 'pip install -r requirements.txt flake8 mypy'
            
            echo 'Ejecutando revisión de código...'
            sh 'make lint'
          }
        }
      }
    }

    // EJERCICIO 3: Separar stage Test
    stage('CI - Test') {
      steps {
        script {
          docker.image("python-ci-tools:${env.BUILD_NUMBER}").inside {
            echo 'Instalando dependencias para las pruebas...'
            sh 'pip install -r requirements.txt pytest flake8 mypy'
            
            echo 'Ejecutando tests unitarios...'
            sh 'make test'
          }
        }
      }
    }
  }
}